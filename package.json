{
  "name": "mystyte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mystyte/site",
    "build": "npm run build -w @mystyte/site",
    "preview": "npm run preview -w @mystyte/site",
    "typecheck": "tsc -b",
    "sync:tabun": "node scripts/tabun.ts",
    "sync:pinned": "node scripts/github-pinned.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
